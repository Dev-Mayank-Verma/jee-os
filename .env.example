# Vercel > Project > Settings > Environment Variables me ye sab daalo
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=koi-lamba-random-string-yahan-daalo
# Vercel AI Gateway is used by /api/ai; no Gemini key is needed.
AI_GATEWAY_MODEL=google/gemini-2.5-flash

# PW API proxy and search endpoints. Keep credentials server-side only.
PW_API_BASE=https://proxy.streamvideo.co.in/fetch/api.penpencil.co
PW_API_HEADERS={}
PW_SEARCH_PATH=https://pwthor.live/api/searchBatch?name={q}&page={page}
PW_BATCH_PATH=/v3/batches/{batchId}/details
PW_SUBJECT_PATH=/v2/batches/{batchId}/subject/{subjectId}/topics?page={page}
PW_SEARCH_FILTER=0
