# Vercel > Project > Settings > Environment Variables me ye sab daalo
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=koi-lamba-random-string-yahan-daalo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PW API (yahan apni API ka base link daalo, jaise https://your-api.com). Khali chhoda toh batch search band rahega
PW_API_BASE=
PW_API_HEADERS={}
PW_SEARCH_PATH=/api/AllBatches?page={page}&search={q}
PW_BATCH_PATH=/api/BatchInfo?BatchId={batchId}&Type=details
PW_SUBJECT_PATH=/api/SubjectInfo?BatchId={batchId}&SubjectId={subjectId}&page=1
PW_SEARCH_FILTER=0
